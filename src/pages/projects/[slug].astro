---
import Base from '@/src/layouts/Base.astro';
import ProjectStory from '@/src/components/ProjectStory.astro';
import { hasStory, projects, type Project } from '@/src/lib/projects';

// A project with its own `page` is published there instead (`/wk`, `/personal-config`), so it
// gets no second copy under `/projects/`.
export function getStaticPaths() {
  return projects
    .filter((project) => hasStory(project) && !project.page)
    .map((project) => ({
      params: { slug: project.slug },
      props: { project },
    }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<Base title={project.title} description={project.blurb}>
  <ProjectStory project={project} />
</Base>
