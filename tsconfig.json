{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "node_modules",
    ".next",
    ".vercel",
    ".wrangler",
    "app",
    "components",
    "content",
    "utils",
    "env.d.ts",
    "next-env.d.ts"
  ]
}
